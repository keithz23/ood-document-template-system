# Copy to .env.vm on both the build machine and the VM. Never commit .env.vm.
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=demo-v1

# Set these after the VM has a stable public IP or domain.
FRONTEND_ORIGIN=https://chiendos.jiramisu.tech
NEXT_PUBLIC_API_URL=/api
DOMAIN_NAME=chiendos.jiramisu.tech

POSTGRES_DB=document_template_system
POSTGRES_USER=document_app
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
POSTGRES_PORT=5432

JWT_ISSUER=DocumentTemplateSystem
JWT_AUDIENCE=DocumentTemplateSystem.Client
JWT_KEY=replace-with-at-least-32-random-bytes
JWT_EXPIRES_MINUTES=60

EMAIL_PROVIDER=Smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USE_STARTTLS=true
EMAIL_SMTP_USER=your-address@gmail.com
EMAIL_SMTP_APP_PASSWORD=replace-with-google-app-password
EMAIL_FROM_ADDRESS=your-address@gmail.com
EMAIL_FROM_NAME=Document Template System

AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
