ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=document_template_system;Username=postgres;Password=postgres"
Cors__AllowedOrigins__0=http://localhost:3000
Jwt__Issuer=DocumentTemplateSystem
Jwt__Audience=DocumentTemplateSystem.Client
Jwt__Key=replace-with-a-random-secret-of-at-least-32-bytes
Jwt__ExpiresMinutes=60
SeedData__Enabled=true
DevelopmentEmail__FrontendBaseUrl=http://localhost:3000
DevelopmentEmail__ExposePasswordResetUrlInLogs=true
RateLimiting__PublicAuthentication__PermitLimit=20
RateLimiting__PublicAuthentication__WindowSeconds=60
